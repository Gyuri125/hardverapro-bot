# Másold le .env néven, és töltsd ki a saját webhook URL-eddel.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
#
# A .env SOHA ne kerüljön fel a gitbe (a .gitignore kizárja).

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/IDE_AZ_ID/IDE_A_TOKEN
